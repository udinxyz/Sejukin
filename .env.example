# SEJUKIN Environment Variables
# Copy this file to .env and fill in your values

# ──────────────────────────────────────────────
# Supabase Configuration (required for Google OAuth and real auth)
# Get these from: https://supabase.com/dashboard → Project Settings → API
# ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ──────────────────────────────────────────────
# Google OAuth Setup (via Supabase)
# ──────────────────────────────────────────────
# 1. Go to Supabase Dashboard → Authentication → Providers → Google
# 2. Enable Google provider
# 3. Set Client ID and Client Secret from Google Cloud Console
# 4. Add Authorized redirect URIs in Google Cloud Console:
#    https://your-project-id.supabase.co/auth/v1/callback
#
# For local development, also add:
#    http://localhost:5173/login-success (or your dev port)
# ──────────────────────────────────────────────

